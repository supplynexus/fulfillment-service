# =================================================================
# SupplyNexus Frontend - 本地开发环境配置示例
# =================================================================
# 复制此文件为 .env.local 并根据实际情况修改配置

# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=SupplyNexus Fulfillment Service

# Hashids Configuration (与后端 environment.local 保持一致)
NEXT_PUBLIC_HASHIDS_SALT=dev-hashids-salt-change-in-prod
NEXT_PUBLIC_HASHIDS_MIN_LENGTH=8

# Frontend JWT Configuration
FRONTEND_JWT_PRIVATE_KEY_PATH=./keys/frontend_jwt_private_key.pem
FRONTEND_JWT_PUBLIC_KEY_PATH=./keys/frontend_jwt_public_key.pem

# Development Settings
NODE_ENV=development
NEXT_PUBLIC_ENVIRONMENT=local
