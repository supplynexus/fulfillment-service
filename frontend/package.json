{
  "name": "fulfillment-service-frontend",
  "version": "1.0.0",
  "description": "SupplyNexus Fulfillment Service Admin Dashboard",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:env": "node scripts/start-with-env.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "check-all": "npm run type-check && npm run lint && npm run format:check",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "generate-keys": "bash scripts/generate-keys.sh",
    "generate-signature": "node scripts/generate-signature.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@mui/material-nextjs": "^7.3.0",
    "@mui/x-data-grid": "^8.10.0",
    "@mui/x-date-pickers": "^8.10.0",
    "@mui/x-tree-view": "^8.14.0",
    "@tanstack/react-query": "^5.12.2",
    "@tanstack/react-query-devtools": "^5.85.3",
    "@types/uuid": "^10.0.0",
    "@uiw/react-json-view": "^2.0.0-alpha.41",
    "axios": "^1.6.2",
    "dayjs": "^1.11.10",
    "dompurify": "^3.3.1",
    "embla-carousel-react": "^8.6.0",
    "hashids": "^2.3.0",
    "jwt-decode": "^4.0.0",
    "next": "^15.4.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.8.0",
    "swr": "^2.2.4",
    "uuid": "^11.1.0",
    "web-vitals": "^5.1.0",
    "zod": "^4.0.17",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^8.55.0",
    "eslint-config-next": "^14.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.1.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
