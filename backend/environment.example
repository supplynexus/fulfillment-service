# =================================================================
# SupplyNexus Backend Environment Configuration
# =================================================================

# Database Configuration
DATABASE_URL=postgresql+asyncpg://supplynexus_admin:IVzrm2bKlWyxWzhU3KVJUOdwU6IEwG32@localhost:5433/supplynexus

# Redis Configuration
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# Security Configuration
SECRET_KEY=dev-jwt-secret-key-change-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
WEBHOOK_SECRET=dev-webhook-secret-change-in-prod

# Application Configuration
ENVIRONMENT=local
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1

# API Configuration
API_V1_STR=/api/v1

# Health Check Configuration
HEALTH_CHECK_API_KEY=your-health-check-api-key
HEALTH_CHECK_RATE_LIMIT=10
HEALTH_CHECK_RATE_WINDOW=60

# Hashids Configuration
HASHIDS_SALT=dev-hashids-salt-change-in-prod
HASHIDS_MIN_LENGTH=8

# Swagger Debug Mode Configuration
SWAGGER_DEBUG_MODE=true

# Optional: External Services
# SHOPIFY_SHOP_NAME=your-shop-name
# SHOPIFY_ACCESS_TOKEN=your-shopify-access-token
# SHOPIFY_API_KEY=your-shopify-api-key
# SHOPIFY_API_SECRET=your-shopify-api-secret
# PRINTIFY_API_TOKEN=your-printify-api-token

# Optional: Sentry Configuration
# SENTRY_DSN=your-sentry-dsn
