# SupplyNexus 应用环境配置模板
# 复制此文件到对应环境，然后编辑配置
# DO NOT commit actual environment files to git
#
# 使用方法:
# 1. 复制此文件: cp env.example env.local
# 2. 编辑配置文件: vim env.local
# 3. 确保基础设施已启动:
#    - PostgreSQL: cd deployment/docker/postgresql && ./deploy.sh dev
#    - Redis: cd deployment/docker/redis && ./deploy.sh dev
# 4. 启动应用: ./deployment/scripts/deploy.sh start

# Environment Type
ENVIRONMENT=local

# Database Configuration (连接到已启动的 PostgreSQL)
# 本地环境配置 (端口: 5432)
DATABASE_URL=postgresql+asyncpg://supplynexus_admin:your_password@localhost:5432/supplynexus
DATABASE_URL_SYNC=postgresql://supplynexus_admin:your_password@localhost:5432/supplynexus

# 开发环境配置 (端口: 5433)
# DATABASE_URL=postgresql+asyncpg://supplynexus_admin:your_password@localhost:5433/supplynexus
# DATABASE_URL_SYNC=postgresql://supplynexus_admin:your_password@localhost:5433/supplynexus

# 测试环境配置 (端口: 5434)
# DATABASE_URL=postgresql+asyncpg://supplynexus_admin:your_password@localhost:5434/supplynexus
# DATABASE_URL_SYNC=postgresql://supplynexus_admin:your_password@localhost:5434/supplynexus

# 生产环境配置 (端口: 5435)
# DATABASE_URL=postgresql+asyncpg://supplynexus_admin:your_password@localhost:5435/supplynexus
# DATABASE_URL_SYNC=postgresql://supplynexus_admin:your_password@localhost:5435/supplynexus

# Redis Configuration (连接到已启动的 Redis)
# 本地环境配置 (端口: 6379)
REDIS_URL=redis://:your_redis_password@localhost:6379/0
CELERY_BROKER_URL=redis://:your_redis_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:your_redis_password@localhost:6379/2

# 开发环境配置 (端口: 6380)
# REDIS_URL=redis://:your_redis_password@localhost:6380/0
# CELERY_BROKER_URL=redis://:your_redis_password@localhost:6380/1
# CELERY_RESULT_BACKEND=redis://:your_redis_password@localhost:6380/2

# 测试环境配置 (端口: 6381)
# REDIS_URL=redis://:your_redis_password@localhost:6381/0
# CELERY_BROKER_URL=redis://:your_redis_password@localhost:6381/1
# CELERY_RESULT_BACKEND=redis://:your_redis_password@localhost:6381/2

# 生产环境配置 (端口: 6382)
# REDIS_URL=redis://:your_redis_password@localhost:6382/0
# CELERY_BROKER_URL=redis://:your_redis_password@localhost:6382/1
# CELERY_RESULT_BACKEND=redis://:your_redis_password@localhost:6382/2

# API Keys (Replace with actual values)
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
PRINTIFY_API_TOKEN=your-printify-api-token

# Security Configuration (Replace with actual values)
SECRET_KEY=your-secret-key-change-in-prod
WEBHOOK_SECRET=your-webhook-secret-change-in-prod

# Application Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: Sentry DSN for error tracking
# SENTRY_DSN=your-sentry-dsn

# Health Check Configuration (Required)
HEALTH_CHECK_API_KEY=your-health-check-api-key-change-in-prod
