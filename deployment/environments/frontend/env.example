# =================================================================
# SupplyNexus Frontend Environment Configuration Example
# =================================================================
# 复制此文件为 env.dev, env.local, env.stg, env.prod 并根据环境修改配置

# Backend API Configuration
# 根据backend部署方式选择正确的URL:
# - Backend在宿主机: http://host.docker.internal:8000
# - Backend在Docker(同网络): http://backend:8000  
# - Backend在远程服务器: http://your-backend-server:8000
NEXT_PUBLIC_API_URL=http://host.docker.internal:8000
BACKEND_API_URL=http://host.docker.internal:8000
NEXT_PUBLIC_APP_NAME=SupplyNexus Fulfillment Service

# Frontend JWT Configuration
# 密钥文件路径 (相对于容器内的/app目录)
FRONTEND_JWT_PRIVATE_KEY_PATH=./keys/frontend_jwt_private_key.pem
FRONTEND_JWT_PUBLIC_KEY_PATH=./keys/frontend_jwt_public_key.pem

# Environment Settings
NODE_ENV=production
NEXT_PUBLIC_ENVIRONMENT=local

# Port Configuration
# 宿主机端口 (容器内固定为3000)
FRONTEND_PORT=3000

# Security Settings
NEXT_TELEMETRY_DISABLED=1

# Performance Settings
NEXT_PUBLIC_ENABLE_ANALYTICS=false
