# =================================================================
# SupplyNexus PostgreSQL Environment Configuration Example
# =================================================================
# 复制此文件为 env.dev, env.local, env.stg, env.prod 并根据环境修改配置

# Database Configuration
POSTGRES_DB=supplynexus
POSTGRES_USER=supplynexus_admin
POSTGRES_PASSWORD=your_password_change_in_prod

# Port Configuration
# 根据环境选择不同的端口避免冲突
POSTGRES_PORT=5432

# Data Directory
# 数据存储目录 (相对于deployment/docker/postgresql/)
DATA_DIR=data-local

# Network Configuration
POSTGRES_NETWORK=fulfillment_network

# Health Check Configuration
POSTGRES_HEALTH_CHECK_INTERVAL=30s
POSTGRES_HEALTH_CHECK_TIMEOUT=10s
POSTGRES_HEALTH_CHECK_RETRIES=5
