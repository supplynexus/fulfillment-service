# =================================================================
# SupplyNexus Redis Environment Configuration Example
# =================================================================
# 复制此文件为 env.dev, env.local, env.stg, env.prod 并根据环境修改配置

# Redis Configuration
REDIS_PASSWORD=your_redis_password_change_in_prod

# Port Configuration
# 根据环境选择不同的端口避免冲突
REDIS_PORT=6379

# Data Directory
# 数据存储目录 (相对于deployment/docker/redis/)
DATA_DIR=data-local

# Network Configuration
REDIS_NETWORK=fulfillment_network

# Health Check Configuration
REDIS_HEALTH_CHECK_INTERVAL=30s
REDIS_HEALTH_CHECK_TIMEOUT=10s
REDIS_HEALTH_CHECK_RETRIES=5

# Redis Configuration Options
REDIS_APPENDONLY=yes
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
