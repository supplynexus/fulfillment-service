# =================================================================
# SupplyNexus Backend Environment Configuration Example
# =================================================================
# 复制此文件为 .env.dev, .env.local, .env.stg, .env.prod 并根据环境修改配置

# =================================================================
# 必需配置
# =================================================================

# 环境类型
ENVIRONMENT=local

# 数据库配置
# 根据PostgreSQL部署方式选择正确的URL:
# - PostgreSQL在宿主机: postgresql://user:pass@localhost:5432/db
# - PostgreSQL在Docker: postgresql://user:pass@postgres:5432/db
DATABASE_URL=postgresql+asyncpg://supplynexus_admin:your_password@localhost:5432/supplynexus
DATABASE_URL_SYNC=postgresql://supplynexus_admin:your_password@localhost:5432/supplynexus

# Redis配置
# 根据Redis部署方式选择正确的URL:
# - Redis在宿主机: redis://:password@localhost:6379/0
# - Redis在Docker: redis://:password@redis:6379/0
REDIS_URL=redis://:your_redis_password@localhost:6379/0
CELERY_BROKER_URL=redis://:your_redis_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:your_redis_password@localhost:6379/2

# 健康检查配置（必需）
HEALTH_CHECK_API_KEY=your-health-check-api-key-change-in-prod
HEALTH_CHECK_RATE_LIMIT=10
HEALTH_CHECK_RATE_WINDOW=60

# 系统API配置（必需）
SYSTEM_API_KEY=your-system-api-key-change-in-prod

# 安全配置
WEBHOOK_SECRET=your-webhook-secret-change-in-prod

# 应用配置
API_V1_STR=/api/v1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1

# Hashids配置（必需）
HASHIDS_SALT=your-hashids-salt-change-in-prod
HASHIDS_MIN_LENGTH=8

# =================================================================
# 可选配置（开发环境可以留空）
# =================================================================

# 错误监控（开发环境可以留空）
# SENTRY_DSN=

# 邮件配置（开发环境可以留空）
# SMTP_TLS=true
# SMTP_PORT=587
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-email-password
# EMAILS_FROM_EMAIL=noreply@supplynexus.store
# EMAILS_FROM_NAME=SupplyNexus

# =================================================================
# 多租户配置说明
# =================================================================
# 注意：以下配置已改为多租户数据库存储，不再在此处配置：
# - SHOPIFY_API_KEY, SHOPIFY_API_SECRET
# - PRINTIFY_API_TOKEN
# - 每个租户的配置存储在 tenants 表中
# - 系统用户配置通过数据库管理，不再需要 SYSTEM_USER_EMAIL
